        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4963"
                TIME_SLOT_REF1="ts17990" TIME_SLOT_REF2="ts17991">
                <ANNOTATION_VALUE>Но это уже тоже после меня рождения.</ANNOTATION_VALUE>
