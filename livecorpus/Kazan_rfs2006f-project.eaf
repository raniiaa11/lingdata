        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4816"
                TIME_SLOT_REF1="ts17696" TIME_SLOT_REF2="ts17697">
                <ANNOTATION_VALUE>И мы спустился по одним ступенькам тем же.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4817"
                TIME_SLOT_REF1="ts17698" TIME_SLOT_REF2="ts17699">
