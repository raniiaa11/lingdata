        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4821"
                TIME_SLOT_REF1="ts17706" TIME_SLOT_REF2="ts17707">
                <ANNOTATION_VALUE>Может быть, это в три года.</ANNOTATION_VALUE>
