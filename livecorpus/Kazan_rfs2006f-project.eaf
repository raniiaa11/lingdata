        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4793"
                TIME_SLOT_REF1="ts15125" TIME_SLOT_REF2="ts15189">
                <ANNOTATION_VALUE>Ну, наверное, да.</ANNOTATION_VALUE>
