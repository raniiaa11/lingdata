        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4807"
                TIME_SLOT_REF1="ts17024" TIME_SLOT_REF2="ts17165">
                <ANNOTATION_VALUE>Там был то ли забор, то ли виноградник</ANNOTATION_VALUE>
