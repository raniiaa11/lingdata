        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4952"
                TIME_SLOT_REF1="ts17968" TIME_SLOT_REF2="ts17969">
                <ANNOTATION_VALUE>И как будто у вас что-то, я хотела подарить Лего с Гарри Поттером.</ANNOTATION_VALUE>
