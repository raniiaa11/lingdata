        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4951"
                TIME_SLOT_REF1="ts17966" TIME_SLOT_REF2="ts17967">
                <ANNOTATION_VALUE>потому что он делает уроки.</ANNOTATION_VALUE>
