        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4967"
                TIME_SLOT_REF1="ts17998" TIME_SLOT_REF2="ts17999">
                <ANNOTATION_VALUE>Провернусь.</ANNOTATION_VALUE>
