        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4799"
                TIME_SLOT_REF1="ts15927" TIME_SLOT_REF2="ts16034">
                <ANNOTATION_VALUE>Там маленький квартирный дом, но трехэтажный, кажется.</ANNOTATION_VALUE>
