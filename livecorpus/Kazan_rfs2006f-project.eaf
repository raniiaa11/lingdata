        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4794"
                TIME_SLOT_REF1="ts15190" TIME_SLOT_REF2="ts15358">
                <ANNOTATION_VALUE>У меня примерно три года или два даже, может быть.</ANNOTATION_VALUE>
