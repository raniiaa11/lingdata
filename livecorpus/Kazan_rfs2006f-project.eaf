                TIME_SLOT_REF1="ts18140" TIME_SLOT_REF2="ts18141">
                <ANNOTATION_VALUE>Но в какой-то момент было страшно, когда я просто висишь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5039"
                TIME_SLOT_REF1="ts18142" TIME_SLOT_REF2="ts18143">
                <ANNOTATION_VALUE>И я еще думаю, я смотрю на эту защиту, вот эти карабины, которые прицеплены экземплярно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5040"
                TIME_SLOT_REF1="ts18144" TIME_SLOT_REF2="ts18145">
                <ANNOTATION_VALUE>Я вот смотрю и думаю, а если сейчас что-нибудь оторется?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5041"
                TIME_SLOT_REF1="ts18146" TIME_SLOT_REF2="ts18147">
                <ANNOTATION_VALUE>Еще учитывая, что я могла неправильно что-то прицепить, а вдруг я сейчас совпаду?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5042"
                TIME_SLOT_REF1="ts18148" TIME_SLOT_REF2="ts18149">
                <ANNOTATION_VALUE>И вот этот момент, наверное, был страшно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5043"
                TIME_SLOT_REF1="ts18150" TIME_SLOT_REF2="ts18151">
                <ANNOTATION_VALUE>Но со мной стояли взрослые из моей семьи внизу.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5044"
                TIME_SLOT_REF1="ts18152" TIME_SLOT_REF2="ts18153">
                <ANNOTATION_VALUE>Они мне там кричали, не бывайте, сейчас я приеду.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5045"
                TIME_SLOT_REF1="ts18154" TIME_SLOT_REF2="ts18155">
                <ANNOTATION_VALUE>И поэтому, наверное, было полегче.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5046"
                TIME_SLOT_REF1="ts18156" TIME_SLOT_REF2="ts18157">
                <ANNOTATION_VALUE>Но в какой-то момент меня начали атаковать эти приможенные мысли.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5047"
                TIME_SLOT_REF1="ts18158" TIME_SLOT_REF2="ts18159">
                <ANNOTATION_VALUE>Такое воспоминание есть.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5048"
                TIME_SLOT_REF1="ts18160" TIME_SLOT_REF2="ts18161">
                <ANNOTATION_VALUE>У нас есть 20 минут, я думаю, мы в целом можем снять.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
