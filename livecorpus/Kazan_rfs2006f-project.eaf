        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4798"
                TIME_SLOT_REF1="ts15816" TIME_SLOT_REF2="ts15926">
                <ANNOTATION_VALUE>Мы жили у этого дома квартирного.</ANNOTATION_VALUE>
