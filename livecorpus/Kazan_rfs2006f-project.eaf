        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4820"
                TIME_SLOT_REF1="ts17704" TIME_SLOT_REF2="ts17705">
                <ANNOTATION_VALUE>Я не знаю, на самом деле, в каком году дети лазят.</ANNOTATION_VALUE>
