        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4811"
                TIME_SLOT_REF1="ts17464" TIME_SLOT_REF2="ts17579">
                <ANNOTATION_VALUE>таких вот этих зеленоватых путих.</ANNOTATION_VALUE>
