        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4802"
                TIME_SLOT_REF1="ts16313" TIME_SLOT_REF2="ts16379">
                <ANNOTATION_VALUE>Забор.</ANNOTATION_VALUE>
