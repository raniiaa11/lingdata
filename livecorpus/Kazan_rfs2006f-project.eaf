        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4815"
                TIME_SLOT_REF1="ts17694" TIME_SLOT_REF2="ts17695">
                <ANNOTATION_VALUE>Кто-то так наверх залез и всё.</ANNOTATION_VALUE>
