        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4301"
                TIME_SLOT_REF1="ts10017" TIME_SLOT_REF2="ts10092">
                <ANNOTATION_VALUE>но вообще жест же не указательный -- такого объекта даже физически не сущесвтует</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3683"
                TIME_SLOT_REF1="ts10479" TIME_SLOT_REF2="ts10489">
                <ANNOTATION_VALUE>это же не указательный -- я не указываю, куда пришла, а именно подчеркиваю...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4318"
                TIME_SLOT_REF1="ts10501" TIME_SLOT_REF2="ts10592">
                <ANNOTATION_VALUE>микроикивочек на моменте закрывания глаз, кажется, есть</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4324"
                TIME_SLOT_REF1="ts10696" TIME_SLOT_REF2="ts10708">
                <ANNOTATION_VALUE>это, кажется, тоже не жест</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3718"
                TIME_SLOT_REF1="ts11475" TIME_SLOT_REF2="ts11512">
                <ANNOTATION_VALUE>в смысле именно не здесь, а вот там </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3728"
                TIME_SLOT_REF1="ts11532" TIME_SLOT_REF2="ts11609">
                <ANNOTATION_VALUE>я не знаю, насколько это не придумано мной в момент разметки. вероятно, просто рекурсия жеста на 9.16.771</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4339"
                TIME_SLOT_REF1="ts11612" TIME_SLOT_REF2="ts11699">
                <ANNOTATION_VALUE>ну тут в целом прямо кисть руки двигается, а не пальцы, прямо отдельно движений пальцев и не наблюдается</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4340"
                TIME_SLOT_REF1="ts11727" TIME_SLOT_REF2="ts11820">
                <ANNOTATION_VALUE>начало считала с начала движения головы</ANNOTATION_VALUE>
