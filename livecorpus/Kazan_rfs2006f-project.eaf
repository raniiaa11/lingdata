        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4806"
                TIME_SLOT_REF1="ts16826" TIME_SLOT_REF2="ts16986">
                <ANNOTATION_VALUE>Картинка у меня какие-то есть такие в голове.</ANNOTATION_VALUE>
