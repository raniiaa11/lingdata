        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4966"
                TIME_SLOT_REF1="ts17996" TIME_SLOT_REF2="ts17997">
                <ANNOTATION_VALUE>Но потом я выяснила, что, вероятно, я так не успею это все сделать.</ANNOTATION_VALUE>
