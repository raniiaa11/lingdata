        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4822"
                TIME_SLOT_REF1="ts17708" TIME_SLOT_REF2="ts17709">
                <ANNOTATION_VALUE>Вот я помню, что мы с бабушкой выходили</ANNOTATION_VALUE>
