        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4965"
                TIME_SLOT_REF1="ts17994" TIME_SLOT_REF2="ts17995">
                <ANNOTATION_VALUE>Я думала о том, чтобы купить все здесь, отправить по почте.</ANNOTATION_VALUE>
