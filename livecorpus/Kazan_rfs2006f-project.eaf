        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4797"
                TIME_SLOT_REF1="ts15656" TIME_SLOT_REF2="ts15815">
                <ANNOTATION_VALUE>но там вообще была такая большая территория.</ANNOTATION_VALUE>
