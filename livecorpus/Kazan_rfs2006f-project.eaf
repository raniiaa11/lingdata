        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4814"
                TIME_SLOT_REF1="ts17692" TIME_SLOT_REF2="ts17693">
                <ANNOTATION_VALUE>Мне казалось, что вот по лестнице лазить это неинтересно.</ANNOTATION_VALUE>
