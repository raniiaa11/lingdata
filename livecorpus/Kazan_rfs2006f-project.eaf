        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4949"
                TIME_SLOT_REF1="ts17962" TIME_SLOT_REF2="ts17963">
                <ANNOTATION_VALUE>И я подумала, что надо что-то связанное с Гарри Поттером подарить.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4950"
                TIME_SLOT_REF1="ts17964" TIME_SLOT_REF2="ts17965">
                <ANNOTATION_VALUE>Вот, и я стала выбирать, что же ему подарить, потому что времени у него реально нет,</ANNOTATION_VALUE>
