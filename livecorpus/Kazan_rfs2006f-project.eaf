        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4964"
                TIME_SLOT_REF1="ts17992" TIME_SLOT_REF2="ts17993">
                <ANNOTATION_VALUE>И поэтому я тоже так думала, как мне все так красивенько сделать.</ANNOTATION_VALUE>
