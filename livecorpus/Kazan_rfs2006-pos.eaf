        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a983"
                TIME_SLOT_REF1="ts1202" TIME_SLOT_REF2="ts1203">
                <ANNOTATION_VALUE>На самую сложную трассу.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a984"
                TIME_SLOT_REF1="ts1204" TIME_SLOT_REF2="ts1205">
                <ANNOTATION_VALUE>Потому что, да, правда, такое с детства, какая на меня любовь к таким штукам.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a985"
                TIME_SLOT_REF1="ts1206" TIME_SLOT_REF2="ts1207">
                <ANNOTATION_VALUE>Ну вот, и в тот раз, да, я тоже на какую-то трассу пошла по горам.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a986"
                TIME_SLOT_REF1="ts1208" TIME_SLOT_REF2="ts1209">
                <ANNOTATION_VALUE>Я не помню, как так получилось.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a987"
                TIME_SLOT_REF1="ts1210" TIME_SLOT_REF2="ts1211">
                <ANNOTATION_VALUE>Ну в общем, там в конце была, был теплая.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a988"
                TIME_SLOT_REF1="ts1212" TIME_SLOT_REF2="ts1213">
                <ANNOTATION_VALUE>Это когда тебя прицепляют как-то там к веревке, которая между горами оттянула.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a989"
                TIME_SLOT_REF1="ts1214" TIME_SLOT_REF2="ts1215">
                <ANNOTATION_VALUE>И вот ты едешь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a990"
                TIME_SLOT_REF1="ts1216" TIME_SLOT_REF2="ts1217">
                <ANNOTATION_VALUE>Вот это такая уже все, конец маршрута.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a991"
                TIME_SLOT_REF1="ts1218" TIME_SLOT_REF2="ts1219">
                <ANNOTATION_VALUE>Съезжаешь и, собственно, все, конец.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a992"
                TIME_SLOT_REF1="ts1220" TIME_SLOT_REF2="ts1221">
                <ANNOTATION_VALUE>Ну вот я так поехала.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a993"
                TIME_SLOT_REF1="ts1222" TIME_SLOT_REF2="ts1223">
                <ANNOTATION_VALUE>И я не знаю, что там случилось.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a994"
                TIME_SLOT_REF1="ts1224" TIME_SLOT_REF2="ts1225">
                <ANNOTATION_VALUE>Я кажется, неправильно, не очень правильно прицепила.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995"
                TIME_SLOT_REF1="ts1226" TIME_SLOT_REF2="ts1227">
                <ANNOTATION_VALUE>Под конец нам надо еще какой-то карабин, что-то прицеплять, какую-то дополнительную защиту.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a996"
                TIME_SLOT_REF1="ts1228" TIME_SLOT_REF2="ts1229">
                <ANNOTATION_VALUE>В общем, я думаю, что я неправильно как-то это прицепила.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a997"
                TIME_SLOT_REF1="ts1230" TIME_SLOT_REF2="ts1231">
                <ANNOTATION_VALUE>И, в общем, на сегодняшний день я трезвеплально застряла.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a998"
                TIME_SLOT_REF1="ts1232" TIME_SLOT_REF2="ts1233">
                <ANNOTATION_VALUE>Вот это было страшно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a999"
                TIME_SLOT_REF1="ts1234" TIME_SLOT_REF2="ts1235">
                <ANNOTATION_VALUE>Так висишь, но тебя все смотрят.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1000"
                TIME_SLOT_REF1="ts1236" TIME_SLOT_REF2="ts1237">
                <ANNOTATION_VALUE>Потом все побежали к Рокотниковой парке сказать, смотрите, там ребенок висит.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1001"
                TIME_SLOT_REF1="ts1238" TIME_SLOT_REF2="ts1239">
                <ANNOTATION_VALUE>Ну у меня, правда, лет восемь было и девять.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1002"
                TIME_SLOT_REF1="ts1240" TIME_SLOT_REF2="ts1241">
                <ANNOTATION_VALUE>И за мной чел поехал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1003"
                TIME_SLOT_REF1="ts1242" TIME_SLOT_REF2="ts1243">
                <ANNOTATION_VALUE>Он вот снизу горы покатился, как-то там что-то как-то засыплялось, доехал до меня.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1004"
                TIME_SLOT_REF1="ts1244" TIME_SLOT_REF2="ts1245">
                <ANNOTATION_VALUE>Потом мою эту штуку поправил, и мы вместе съехали.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1005"
                TIME_SLOT_REF1="ts1246" TIME_SLOT_REF2="ts1247">
                <ANNOTATION_VALUE>Но в какой-то момент было страшно, когда я просто висишь.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1006"
                TIME_SLOT_REF1="ts1248" TIME_SLOT_REF2="ts1249">
                <ANNOTATION_VALUE>И я еще думаю, я смотрю на эту защиту, вот эти карабины, которые прицеплены экземплярно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1007"
                TIME_SLOT_REF1="ts1250" TIME_SLOT_REF2="ts1251">
                <ANNOTATION_VALUE>Я вот смотрю и думаю, а если сейчас что-нибудь оторется?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1008"
                TIME_SLOT_REF1="ts1252" TIME_SLOT_REF2="ts1253">
                <ANNOTATION_VALUE>Еще учитывая, что я могла неправильно что-то прицепить, а вдруг я сейчас совпаду?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1009"
                TIME_SLOT_REF1="ts1254" TIME_SLOT_REF2="ts1255">
                <ANNOTATION_VALUE>И вот этот момент, наверное, был страшно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1010"
                TIME_SLOT_REF1="ts1256" TIME_SLOT_REF2="ts1257">
                <ANNOTATION_VALUE>Но со мной стояли взрослые из моей семьи внизу.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1011"
                TIME_SLOT_REF1="ts1258" TIME_SLOT_REF2="ts1259">
                <ANNOTATION_VALUE>Они мне там кричали, не бывайте, сейчас я приеду.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1012"
                TIME_SLOT_REF1="ts1260" TIME_SLOT_REF2="ts1261">
                <ANNOTATION_VALUE>И поэтому, наверное, было полегче.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1013"
                TIME_SLOT_REF1="ts1262" TIME_SLOT_REF2="ts1263">
                <ANNOTATION_VALUE>Но в какой-то момент меня начали атаковать эти приможенные мысли.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1014"
                TIME_SLOT_REF1="ts1264" TIME_SLOT_REF2="ts1265">
                <ANNOTATION_VALUE>Такое воспоминание есть.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1015"
                TIME_SLOT_REF1="ts1266" TIME_SLOT_REF2="ts1267">
                <ANNOTATION_VALUE>У нас есть 20 минут, я думаю, мы в целом можем снять.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
